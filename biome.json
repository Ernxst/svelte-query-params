{
	"$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/.DS_Store",
			"!**/.turbo",
			"!**/.svelte-kit/",
			"!**/.idea/",
			"!**/yarn.lock",
			"!**/bun.lockb",
			"!**/node_modules/",
			"!**/coverage/",
			"!**/build/",
			"!**/dist/",
			"!**/static/",
			"!**/vite.config.ts.*",
			"!**/vitest.config.ts.*",
			"!**/tsup.config.ts.*",
			"!**/*.md",
			"!**/*.yml",
			"!**/*.yaml",
			"!**/*.css"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		}
	],
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80
	},
	"javascript": {
		"formatter": {
			"trailingCommas": "es5"
		}
	},
	"json": {
		"parser": {
			"allowComments": true,
			"allowTrailingCommas": true
		}
	}
}
